{
	# Set a real email via ACME_EMAIL at runtime.
	email {$ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	# Global error handling for all sites
	# Shows custom error pages automatically without needing to add them to each site
	order injection after encode
	servers {
		protocols h1 h2 h3
	}
}

# Global error page handling
# This applies to all sites unless they define their own handle_errors
(auto_error_pages) {
	# Serve error page assets (logo, etc.)
	handle /error-assets/* {
		uri strip_prefix /error-assets
		root * /usr/local/share/caddy/error-pages
		file_server
	}

	# Serve global assets (shared across all sites)
	handle /global-assets/* {
		uri strip_prefix /global-assets
		root * /usr/local/share/caddy/sites/global-assets
		file_server
	}

	handle_errors {
		@400 expression {http.error.status_code} == 400
		@401 expression {http.error.status_code} == 401
		@403 expression {http.error.status_code} == 403
		@404 expression {http.error.status_code} == 404
		@408 expression {http.error.status_code} == 408
		@409 expression {http.error.status_code} == 409
		@418 expression {http.error.status_code} == 418
		@422 expression {http.error.status_code} == 422
		@429 expression {http.error.status_code} == 429
		@451 expression {http.error.status_code} == 451
		@500 expression {http.error.status_code} == 500
		@502 expression {http.error.status_code} == 502
		@503 expression {http.error.status_code} == 503
		@504 expression {http.error.status_code} == 504
		@maintenance_503 expression `{http.error.status_code} == 503 && (({env.MAINTENANCE_ALL} == "1" || {env.MAINTENANCE_ALL} == "true") || (({env.MAINTENANCE_STAGE} == "1" || {env.MAINTENANCE_STAGE} == "true") && {host}.matches("(^|\\.)stage\\..+")) || (({env.MAINTENANCE_DEV} == "1" || {env.MAINTENANCE_DEV} == "true") && {host}.matches("(^|\\.)dev\\..+")) || (({env.MAINTENANCE_PROD} == "1" || {env.MAINTENANCE_PROD} == "true") && !{host}.matches("(^|\\.)stage\\..+") && !{host}.matches("(^|\\.)dev\\..+")))`

		handle @400 {
			rewrite * /400.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @401 {
			rewrite * /401.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @403 {
			rewrite * /403.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @404 {
			rewrite * /404.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @408 {
			rewrite * /408.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @409 {
			rewrite * /409.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @418 {
			rewrite * /418.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @422 {
			rewrite * /422.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @429 {
			rewrite * /429.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @451 {
			rewrite * /451.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @500 {
			rewrite * /500.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @502 {
			rewrite * /502.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @maintenance_503 {
			rewrite * /maintenance.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @503 {
			rewrite * /503.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}

		handle @504 {
			rewrite * /504.html
			root * /usr/local/share/caddy/error-pages
			file_server
		}
	}
}

# Import reusable snippets globally
# Note: Matchers cannot be imported globally - import them in site blocks if needed
import /usr/local/share/caddy/_snippets.inc

# Import all site configurations
import /sites/*.caddy
